# Variables de entorno para el servicio en Render (o equivalente). No se lee automáticamente:
# cárguelas una por una en el dashboard del proveedor (Render: Environment > Add Environment Variable).

# Cadena de conexión de Neon (Settings > Connection string). Debe incluir sslmode=require.
DATABASE_URL="postgresql://usuario:password@ep-xxxx.neon.tech/control_servicio?sslmode=require"

# Genere uno nuevo para producción, distinto del usado en desarrollo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="reemplace-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# URL pública del frontend en Vercel/Netlify (sin slash final).
FRONTEND_ORIGIN="https://control-servicio.vercel.app"

# En producción (HTTPS) debe ser "true": habilita cookies Secure + SameSite=None,
# necesario porque frontend y backend están en dominios distintos.
COOKIE_SECURE="true"

# Credenciales del usuario Administrador que se crea automáticamente en el primer arranque
# (prisma/seed.ts). Cámbielas por unas propias antes de desplegar.
SEED_ADMIN_DOCUMENTO="admin"
SEED_ADMIN_PASSWORD="reemplace-por-una-contrasena-fuerte"

# Render la define automáticamente; no hace falta configurarla a mano.
# PORT=10000
