generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
  ASESOR
  CONSULTA
  // Aún sin acceso a ningún módulo (ver Tecnico más abajo); en el futuro entrará a "Agenda de
  // Servicio" para ver sus servicios programados.
  TECNICO_SERVICIO
}

enum AccionAuditoria {
  CREAR
  EDITAR
  INACTIVAR
  REACTIVAR
  LOGIN
  CAMBIO_PASSWORD
}

enum ModuloImportacion {
  FACTURACION
}

enum EstadoImportacion {
  PROCESANDO
  COMPLETADO
  COMPLETADO_CON_ERRORES
  FALLIDO
}

enum EstadoSeguimiento {
  PENDIENTE
  REALIZADO
}

// Flujo real (ver hoja "indicaciones" del Excel de origen): nace RADICADO cuando el asesor la
// crea, un coordinador la mueve a PROGRAMADO/EN_PROCESO a medida que avanza, y termina en CERRADO
// o CANCELADO. "Eliminar" en la UI no borra la fila: la pasa a CANCELADO.
enum EstadoOrdenTrabajo {
  RADICADO
  PROGRAMADO
  EN_PROCESO
  CERRADO
  CANCELADO
}

enum PrioridadOrdenTrabajo {
  ALTA
  MEDIA
  BAJA
}

// Colapsa las variantes libres encontradas en el Excel de origen (p.ej. "P YC" y "PV y CR" ->
// PREVENTIVO_CORRECTIVO, "DIAGNOSTICO"/"Diagnóstico" -> DIAGNOSTICO) a un catálogo fijo.
enum TipoServicioOrdenTrabajo {
  PREVENTIVO
  CORRECTIVO
  PREVENTIVO_CORRECTIVO
  DIAGNOSTICO
  CORTESIA
  GARANTIA
  ENTREGA
}

// PENDIENTE: recién creada, todavía sin técnico ni fecha programada. PROGRAMADA: a futuro, cuando
// exista el submódulo "Servicios programados", quedará asignada a un técnico/fecha. "Eliminar" en
// la UI no borra la fila: la pasa a CANCELADA.
enum EstadoSolicitudServicio {
  PENDIENTE
  PROGRAMADA
  CANCELADA
}

model User {
  id              String   @id @default(cuid())
  nombres         String
  apellidos       String
  numeroDocumento String   @unique
  correo          String
  telefono        String
  rol             Rol
  passwordHash    String
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditsAsActor  AuditLog[]          @relation("ActorAudits")
  auditsAsTarget AuditLog[]          @relation("TargetAudits")
  importBatches  ImportBatch[]
  facturas       Factura[]
  seguimientosRegistrados ClienteSeguimiento[]
  parametrosSeguimientoActualizados ParametroSeguimiento[]
  asesor         Asesor?
  tecnico        Tecnico?
  ordenesTrabajoCreadas     OrdenTrabajo[] @relation("OrdenTrabajoCreadaPor")
  ordenesTrabajoActualizadas OrdenTrabajo[] @relation("OrdenTrabajoActualizadaPor")
  solicitudesServicioCreadas SolicitudServicio[]

  @@map("users")
}

model AuditLog {
  id             String          @id @default(cuid())
  actorUserId    String
  actor          User            @relation("ActorAudits", fields: [actorUserId], references: [id])
  targetUserId   String?
  target         User?           @relation("TargetAudits", fields: [targetUserId], references: [id])
  accion         AccionAuditoria
  entidad        String
  cambios        Json?
  createdAt      DateTime        @default(now())

  @@index([targetUserId])
  @@index([actorUserId])
  @@map("audit_logs")
}

model ImportBatch {
  id            String            @id @default(cuid())
  modulo        ModuloImportacion
  nombreArchivo String
  subidoPorId   String
  subidoPor     User              @relation(fields: [subidoPorId], references: [id])
  filasTotal    Int               @default(0)
  filasNuevas   Int               @default(0)
  filasActualizadas Int           @default(0)
  filasError    Int               @default(0)
  estado        EstadoImportacion @default(PROCESANDO)
  errores       Json?
  createdAt     DateTime          @default(now())

  facturas      Factura[]

  @@map("import_batches")
}

model Factura {
  id                String   @id @default(cuid())
  anioMesNatural    String?
  centro            String?
  centro2           String?
  centroBeneficio   String?
  pssr              String?
  motivoPedido      String?
  pedido            String
  marca             String?
  cliente           String?
  factura           String
  fechaDocumento    DateTime?
  fechaFacturacion  DateTime?
  piezas            Decimal?  @db.Decimal(18, 4)
  ventaNeta         Decimal?  @db.Decimal(18, 4)
  grossMarginUsd    Decimal?  @db.Decimal(18, 4)
  repuestos         Decimal?  @db.Decimal(18, 4)
  margenPct         Decimal?  @db.Decimal(18, 6)
  manoObra          Decimal?  @db.Decimal(18, 4)
  trabajosTerceros  Decimal?  @db.Decimal(18, 4)
  insumos           Decimal?  @db.Decimal(18, 4)
  descuento         Decimal?  @db.Decimal(18, 4)
  descuentoPct      Decimal?  @db.Decimal(18, 6)
  anio              Int?
  mes               String?
  pctRepuestos      Decimal?  @db.Decimal(18, 6)
  pctManoObra       Decimal?  @db.Decimal(18, 6)
  unidad            String?
  tipoDoc           String?
  causalNc          String?
  anioCompra        Int?
  mesCompra         Int?
  fechaPrimeraCompra DateTime?
  primerMesCompra   String?
  esquemaServicio   String?
  tipoFacturacion   String?
  ultimaFactura     DateTime?
  seguimientoFecha  DateTime?

  // Estado activo/inactivo: al recargar un archivo, si una fila nueva coincide en claveDedupe con
  // una fila activa existente, esa fila anterior se inactiva y la nueva queda como la activa. Toda
  // la aplicación (listados, tablero, proyección) solo debe leer registros con activo = true.
  activo            Boolean     @default(true)
  // Llave combinada (cliente + factura + fechaFacturacion + tipoFacturacion, normalizados) usada
  // para detectar recargas del mismo renglón. Null si a la fila le falta alguno de esos cuatro
  // datos (ver src/utils/dedupeKey.ts). El índice único parcial que garantiza como máximo un
  // activo por llave se agrega a mano en la migración (Prisma no expresa índices parciales).
  claveDedupe       String?

  importBatchId     String
  importBatch       ImportBatch @relation(fields: [importBatchId], references: [id])
  subidoPorId       String
  subidoPor         User        @relation(fields: [subidoPorId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([pssr])
  @@index([fechaFacturacion])
  @@index([cliente])
  @@index([centro])
  @@index([activo])
  @@index([claveDedupe])
  @@map("facturas")
}

// Historial de seguimientos registrados sobre un cliente para un tipo de facturación dado
// (Repuestos / Servicio / Estibadores). Cada acción de "Registrar seguimiento" agrega una fila
// nueva (no sobrescribe la anterior), de forma que se conserva el historial completo por
// cliente + tipo de facturación. La fecha de próximo seguimiento se calcula a partir del
// registro más reciente de este historial (o de la última factura si nunca se ha registrado uno).
model ClienteSeguimiento {
  id               String            @id @default(cuid())
  cliente          String
  tipoFacturacion  String
  estado           EstadoSeguimiento @default(PENDIENTE)
  fechaSeguimiento DateTime
  observaciones    String?

  registradoPorId  String?
  registradoPor    User?             @relation(fields: [registradoPorId], references: [id])
  createdAt        DateTime          @default(now())

  @@index([cliente, tipoFacturacion])
  @@index([estado])
  @@map("cliente_seguimientos")
}

// Maestro de asesores: nombre canónico contra el que se compara el PSSR de las facturas y de los
// seguimientos. Se puebla de dos formas: (1) automáticamente al crear un usuario con rol Asesor,
// y (2) automáticamente al importar Facturación, con cualquier PSSR nuevo que aparezca en el
// Excel y todavía no esté registrado. Cuando el asesor tiene cuenta de acceso al sistema, userId
// queda vinculado; los que solo existen por aparecer en el Excel quedan sin vincular.
model Asesor {
  id              String   @id @default(cuid())
  nombreCompleto  String   @unique
  numeroDocumento String?
  correo          String?
  telefono        String?
  activo          Boolean  @default(true)

  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("asesores")
}

// Parametrización de días para calcular la próxima fecha de seguimiento a partir de la fecha de
// facturación, configurable por tipo de facturación (Repuestos / Servicio / Estibadores).
model ParametroSeguimiento {
  id               String   @id @default(cuid())
  tipoFacturacion  String   @unique
  diasSeguimiento  Int

  actualizadoPorId String?
  actualizadoPor   User?    @relation(fields: [actualizadoPorId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("parametros_seguimiento")
}

// Órdenes de trabajo: el asesor la crea a partir de una solicitud de servicio (con base en las
// columnas del Excel "Solicitudes_Servicio" que reemplaza) y cualquier Asesor o Administrador
// puede consultarla/editarla/cancelarla (acceso colaborativo, igual que el Excel compartido que
// se venía usando). "Eliminar" en la UI no borra la fila: pasa el estado a CANCELADO.
model OrdenTrabajo {
  id      String @id @default(cuid())
  numero  Int    @unique @default(autoincrement()) // consecutivo interno de visualización

  // --- Solicitud (la diligencia el asesor) ---
  fechaSolicitud      DateTime
  cliente             String
  clienteNit          String? // no viene en el Excel de origen; se puede prellenar desde un PDF
  numeroClienteSap    String? // idem, prellenado desde PDF si está disponible
  asesorPssr          String
  valor               Decimal?                  @db.Decimal(18, 2)
  horasServicio       Decimal?                  @db.Decimal(10, 2)
  horasDesplazamiento Decimal?                  @db.Decimal(10, 2)
  ordenTrabajoNumero  String? // número de orden/pedido (SAP); texto libre, a veces queda pendiente
  tipoServicio        TipoServicioOrdenTrabajo
  descripcionServicio String?
  sucursal            String?
  direccion           String?
  ciudad              String?
  departamento        String?
  personaContacto     String?
  correoContacto      String?
  telefonoContacto    String?
  marca               String?
  modelo              String?
  serialMaquina       String?
  coordinadorAltura   Boolean @default(false)
  equipoApoyo         Boolean @default(false)
  fechaSugerida       DateTime?

  // --- Programación / cierre (las diligencia el coordinador, pero cualquiera puede editar hoy) ---
  fechaProgramacionReal   DateTime?
  horaServicio            String? // "HH:mm", texto libre como en el Excel de origen
  estado                  EstadoOrdenTrabajo    @default(RADICADO)
  prioridad               PrioridadOrdenTrabajo @default(MEDIA)
  tecnicoAsignado         String?
  codigoSap               String?
  fechaCierre             DateTime?
  observaciones           String?
  programadorSegunSede    String?
  unidadIntervenirTaller  Boolean @default(false)
  tipoTrabajo             String?
  fechaTrasladoTaller     DateTime?
  reporteClick            Boolean @default(false)

  creadoPorId       String
  creadoPor         User     @relation("OrdenTrabajoCreadaPor", fields: [creadoPorId], references: [id])
  actualizadoPorId  String?
  actualizadoPor    User?    @relation("OrdenTrabajoActualizadaPor", fields: [actualizadoPorId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  solicitudesServicio SolicitudServicio[]

  @@index([cliente])
  @@index([asesorPssr])
  @@index([estado])
  @@index([fechaSolicitud])
  @@map("ordenes_trabajo")
}

// Submódulo "Solicitud de servicio" (dentro de Servicio). Se crea siempre a partir de una Orden de
// trabajo ya cargada (asociación obligatoria) — cliente, ciudad y máquina se leen de esa orden, no
// se duplican aquí. La fecha solicitada es la fecha en la que se pide el servicio; a futuro, el
// submódulo "Servicios programados" la tomará para asignar técnico según su capacidad diaria.
// "Eliminar" en la UI no borra la fila: pasa el estado a CANCELADA.
model SolicitudServicio {
  id     String @id @default(cuid())
  numero Int    @unique @default(autoincrement())

  ordenTrabajoId String
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])

  fechaSolicitada DateTime
  estado          EstadoSolicitudServicio @default(PENDIENTE)
  observaciones   String?

  creadoPorId String
  creadoPor   User     @relation(fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ordenTrabajoId])
  @@index([estado])
  @@index([fechaSolicitada])
  @@map("solicitudes_servicio")
}

// Maestro de técnicos (módulo "Administración de alistamientos"). Es un registro de datos
// maestros independiente, igual que Asesor: puede existir sin cuenta de acceso al sistema. Cuando
// alguien crea/edita un User con rol TECNICO_SERVICIO, se vincula automáticamente por nombre
// (mismo patrón que registrarAsesorDeUsuario). El rol TECNICO_SERVICIO hoy no tiene acceso a
// ningún módulo; a futuro entrarán a "Agenda de Servicio" a ver sus servicios programados.
model Tecnico {
  id        String  @id @default(cuid())
  nombres   String
  apellidos String
  cargo     String?
  telefono  String?
  correo    String?
  activo    Boolean @default(true)

  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capacidades CapacidadTecnico[]

  @@index([activo])
  @@map("tecnicos")
}

// Capacidad diaria del técnico por mes del año (1-12, sin año: es una plantilla que se reutiliza
// cada año hasta que se cambie), para planeación de "Agenda de Servicio" a futuro.
model CapacidadTecnico {
  id              String  @id @default(cuid())
  tecnicoId       String
  tecnico         Tecnico @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  mes             Int // 1-12
  capacidadDiaria Int     @default(0)

  updatedAt DateTime @updatedAt

  @@unique([tecnicoId, mes])
  @@map("capacidades_tecnico")
}
